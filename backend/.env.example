# Application Environment
NODE_ENV=development
PORT=3000

# Security Secrets (Replace with secure random strings in production)
JWT_SECRET=dev_jwt_secret_change_me_in_production_123456789
API_KEY_SALT=dev_api_salt_change_me_in_production_987654321

# Database & Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellar_cert_dev
STORAGE_REQUIRED=true

# Redis & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
EMAIL_QUEUE_NAME=email-queue

# Email Service Credentials
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@stellar-cert.local

# Stellar / Soroban Network Configuration
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
CONTRACT_ID=CBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ADMIN_SECRET_KEY=SCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX